def sumar(a, b):
    return a + b
 
def restar(a, b):
    return a - b
 
def multiplicar(a, b):
    return a * b
 
def dividir(a, b):
    if b == 0:
        return "No se puede dividir entre 0"
    return a / b
 
def potencia(a, b):
    return a ** b
 
opcion = -1
 
while opcion != 0:
    print()
    print("----- CALCULADORA -----")
    print("1. Sumar")
    print("2. Restar")
    print("3. Multiplicar")
    print("4. Dividir")
    print("5. Potencia")
    print("0. Salir")
    opcion = int(input("Elige una opcion: "))
 
    if opcion == 0:
        print("Adios!")
    elif opcion >= 1 and opcion <= 5:
        a = float(input("Primer numero: "))
        b = float(input("Segundo numero: "))
 
        if opcion == 1:
            print("Resultado:", sumar(a, b))
        elif opcion == 2:
            print("Resultado:", restar(a, b))
        elif opcion == 3:
            print("Resultado:", multiplicar(a, b))
        elif opcion == 4:
            print("Resultado:", dividir(a, b))
        elif opcion == 5:
            print("Resultado:", potencia(a, b))
    else:
        print("Esa opcion no existe")